<?xml version="1.0" encoding="utf-8"?>
<!-- A cross-fade, and deliberately no sideways travel.

     A card that slides in from the right says "forward", and there is no
     way to make it say "back" when the left arrow is tapped: a RemoteViews
     cannot set a flipper's animations, so the direction can only come from
     the layout, and sending a different layout makes the host inflate the
     widget again. That rebuilds the flipper with an adapter that has not
     loaded yet, and setDisplayedChild against an empty adapter clamps to
     zero, so every tap on the left arrow jumped back to the first card.

     An animation that implies a direction it cannot honour is worse than
     one that implies none. This fades and lifts slightly, which reads as
     a change of card either way.

     One objectAnimator, never a set: AdapterViewAnimator loads this with
     AnimatorInflater and casts to ObjectAnimator, and an AnimatorSet
     throws that cast with the launcher showing an error card in its place. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <propertyValuesHolder
        android:propertyName="alpha"
        android:valueFrom="0.0"
        android:valueTo="1.0"
        android:valueType="floatType" />
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueFrom="0.96"
        android:valueTo="1.0"
        android:valueType="floatType" />
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueFrom="0.96"
        android:valueTo="1.0"
        android:valueType="floatType" />
</objectAnimator>
