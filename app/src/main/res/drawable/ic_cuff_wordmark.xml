            <gradient android:type="linear" android:startX="0" android:startY="0"
                android:endX="40" android:endY="56">
                <item android:offset="0" android:color="#FFD8D1"/>
                <item android:offset="1" android:color="#CE7B82"/>
            </gradient>
        </aapt:attr>
    </path>

    <group android:translateX="48" android:translateY="-26">
        <path android:pathData="M49,26 h10 a11,11 0 0 1 11,11 v34 a11,11 0 0 1 -11,11 h-10 a11,11 0 0 1 -11,-11 v-34 a11,11 0 0 1 11,-11 z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="38" android:startY="26"
                    android:endX="70" android:endY="82">
                    <item android:offset="0" android:color="#FFE4DE"/>
                    <item android:offset="1" android:color="#C06C76"/>
                </gradient>
            </aapt:attr>
        </path>
        <group>
