<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded rectangle to tint. GlanceModifier.cornerRadius is API 31 and
     this app goes back to 28, so every rounded surface in a widget is this
     shape with a ColorFilter on it rather than a corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="#FFFFFFFF" />
</shape>
