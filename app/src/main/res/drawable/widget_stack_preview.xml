<?xml version="1.0" encoding="utf-8"?>
<!--
  The stack, in the picker.

  The other five providers share one preview because they differ only in
  how big they are, and the launcher draws them at their own cell anyway.
  This one differs in kind, so it gets its own drawing: three cards offset
  behind one another, which is the only thing about a stack somebody needs
  to recognise before they drop it.

  Greys rather than the app's accent, for the same reason as the other
  preview: the picker cannot tell us which theme is in use.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="110dp"
    android:viewportWidth="180"
    android:viewportHeight="110">

    <!-- the two behind, peeking out as a stack does -->
    <path
        android:fillColor="#FF20262B"
        android:pathData="M40,10 L164,10 A12,12 0 0 1 176,22 L176,26 L40,26 Z" />
    <path
        android:fillColor="#FF262D33"
        android:pathData="M28,20 L160,20 A12,12 0 0 1 172,32 L172,38 L28,38 Z" />

    <!-- the front card -->
    <path
        android:fillColor="#FF1A1F24"
        android:pathData="M16,32 L152,32 A14,14 0 0 1 166,46 L166,86 A14,14 0 0 1 152,100 L16,100 A14,14 0 0 1 2,86 L2,46 A14,14 0 0 1 16,32 Z" />

    <!-- a kicker and a figure on the front card -->
    <path
        android:fillColor="#FF5A646D"
        android:pathData="M16,44 L52,44 L52,49 L16,49 Z" />
    <path
        android:fillColor="#FFB8C2CC"
        android:pathData="M16,56 L74,56 L74,70 L16,70 Z" />

    <!-- and a chart under it -->
    <path
        android:fillColor="#FF3D464E"
        android:pathData="M16,88 L24,88 L24,78 L16,78 Z M30,88 L38,88 L38,72 L30,72 Z M44,88 L52,88 L52,80 L44,80 Z M58,88 L66,88 L66,68 L58,68 Z M72,88 L80,88 L80,76 L72,76 Z" />

    <!-- the dots that say there is more than one card -->
    <path
        android:fillColor="#FF5A646D"
        android:pathData="M150,56 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
    <path
        android:fillColor="#FF3D464E"
        android:pathData="M150,68 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z M150,80 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
</vector>
