<?xml version="1.0" encoding="utf-8"?>
<!--
  The band, its clasp, and the buzz either side.

  Drawn on the 108dp adaptive canvas with everything inside the 66dp safe
  circle, because a launcher may crop to a circle, a squircle, a rounded
  square or a teardrop and only that circle is guaranteed. The outer pair
  of arcs is what decides the scale: it reaches further from the centre
  than the band does.

  No blurred shadow. A vector drawable takes gradients and does not take
  blur, and the preview's soft shadow could only ship as a PNG — which
  would cost the monochrome themed layer and the crispness at every
  density. The depth here is the gradient across the face and the clasp's
  own contrast against it, both of which survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- the strap -->
    <path android:pathData="M49,26 h10 a11,11 0 0 1 11,11 v34 a11,11 0 0 1 -11,11 h-10 a11,11 0 0 1 -11,-11 v-34 a11,11 0 0 1 11,-11 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="38" android:startY="26"
                android:endX="70" android:endY="82">
                <item android:offset="0" android:color="#FFE4DE"/>
                <item android:offset="1" android:color="#C06C76"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- the weave, clipped to the strap by sharing its corners -->
    <group>
        <clip-path android:pathData="M49,26 h10 a11,11 0 0 1 11,11 v34 a11,11 0 0 1 -11,11 h-10 a11,11 0 0 1 -11,-11 v-34 a11,11 0 0 1 11,-11 z"/>
        <path android:pathData="M36,34 h36 M36,40 h36 M36,46 h36 M36,52 h36 M36,58 h36 M36,64 h36 M36,70 h36 M36,76 h36"
            android:strokeColor="#8E4A52" android:strokeWidth="2" android:strokeAlpha="0.38"/>
        <path android:pathData="M42,28.5 h24"
            android:strokeColor="#FFFFFF" android:strokeWidth="3.5" android:strokeAlpha="0.45"
            android:strokeLineCap="round"/>
    </group>

    <!-- the clasp, proud of the strap on both sides -->
    <path android:pathData="M40,47 h28 a7,7 0 0 1 0,14 h-28 a7,7 0 0 1 0,-14 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="47"
                android:endX="54" android:endY="61">
                <item android:offset="0" android:color="#FFFFFF"/>
                <item android:offset="1" android:color="#EDCFCB"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- the buzz: near pair bright, far pair faint -->
    <path android:pathData="M34,48 Q30,54 34,60" android:strokeColor="#E7A6A6"
        android:strokeWidth="3.5" android:strokeLineCap="round"/>
    <path android:pathData="M28,44 Q23,54 28,64" android:strokeColor="#E7A6A6"
        android:strokeWidth="3.5" android:strokeAlpha="0.45" android:strokeLineCap="round"/>
    <path android:pathData="M74,48 Q78,54 74,60" android:strokeColor="#E7A6A6"
        android:strokeWidth="3.5" android:strokeLineCap="round"/>
    <path android:pathData="M80,44 Q85,54 80,64" android:strokeColor="#E7A6A6"
        android:strokeWidth="3.5" android:strokeAlpha="0.45" android:strokeLineCap="round"/>
</vector>
