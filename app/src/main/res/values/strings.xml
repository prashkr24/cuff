<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher's widget picker reads android:description from a string
  resource and nowhere else, which is why this file exists at all: the only
  other string this app ships is app_name, and that one varies per build
  type so it comes from resValue in app/build.gradle.kts.

  One line per cell, because the picker has one entry per cell. Each says
  what the size is for and that the reading is chosen afterwards. A picker
  entry called simply "CUFF" would look like a widget that does nothing
  until you drop it.
-->
<resources>
    <string name="widget_strip_description">One figure. You pick which after you drop it.</string>
    <string name="widget_square_description">One reading and its chart. You pick which after you drop it.</string>
    <string name="widget_row_description">A reading across a whole row. You pick which after you drop it.</string>
    <string name="widget_wide_description">A reading, its goal and its week. You pick which after you drop it.</string>
    <string name="widget_tall_description">The whole story, for the readings that fill it.</string>
    <!-- Shown under each entry in the launcher's picker. Without these
         every provider is called after the app, so the picker is six rows
         of the same name and the only thing telling them apart is a
         sentence under a thumbnail. -->
    <string name="widget_strip_label">Small widget</string>
    <string name="widget_square_label">Square widget</string>
    <string name="widget_row_label">Row widget</string>
    <string name="widget_wide_label">Wide widget</string>
    <string name="widget_tall_label">Tall widget</string>
    <string name="widget_stack_label">Stack</string>
    <string name="widget_stack_description">Several widgets in one cell. Swipe through them.</string>
    <!-- A stack that has never been told what to hold, and only that. It
         used to be shown for the other empty state as well, a stack set
         up perfectly well whose cards had not been composed yet, which is
         how a reboot came to ask somebody to set up a widget they had set
         up in August. The two states are told apart in stackViews now. -->
    <string name="widget_stack_empty">Tap to choose what this stack holds</string>
    <!-- A stack that holds designs but has no cards to show for them. After
         the kept snapshot arrived this should be the sub-second gap while
         the launcher binds the adapter, and nothing else: onDataSetChanged
         draws from disk when Health Connect cannot be reached, so a
         configured stack composes a card per design whatever happens. It is
         worded for the case where that has somehow failed anyway, because
         that is the only case anybody will read it in. -->
    <string name="widget_stack_quiet">Open the app to draw this stack</string>
    <string name="widget_stack_previous">Previous card</string>
    <string name="widget_stack_next">Next card</string>
</resources>
