<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window behind Compose. Everything the user sees is themed in
         AirBridgeTheme; this exists so the first frame is not white-on-dark. -->
    <style name="Theme.AirBridge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
